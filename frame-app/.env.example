# Used by docker-compose.yml (Caddy) and passed into the app container.

# The domain/subdomain FRAME will be served on, e.g. frame.yourdomain.com
# or something-yourname.duckdns.org. Must point (A record) at this
# server's IP before you run `docker compose up`.
DOMAIN=frame.example.com

# Required: without these two set, ANYONE who finds the domain can use it.
# Pick your own values — this is the login the browser will prompt for.
AUTH_USER=changeme
AUTH_PASS=change-this-to-something-only-you-know

# Optional: only needed if you're mounting a cookies.txt for stories/private
# content (see docker-compose.yml).
COOKIES_FILE=./cookies.txt
