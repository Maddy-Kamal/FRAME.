# Port the API server runs on
PORT=8787

# Optional: path to a cookies.txt file (Netscape format) exported from your
# logged-in Instagram session. Required for stories, highlights, and any
# private content. Leave blank to only support public posts/reels.
COOKIES_FILE=./cookies.txt

# Optional: path to the yt-dlp binary if it's not on your system PATH
YTDLP_PATH=yt-dlp
